class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode* dummy = new ListNode(0);
        dummy->next = head;

        ListNode* L = dummy;
        ListNode* R = dummy;

        for(int i = 0; i < n; i++) {
            R = R->next;
        }

        while(R->next != NULL) {
            R = R->next;
            L = L->next;
        }

        L->next = L->next->next;
        return dummy->next;
    }
};
